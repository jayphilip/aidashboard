# ===================================
# Local Development
# ===================================
# When running locally with docker-compose.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:54321/aidashboard

# ===================================
# Production (Hetzner VPS via Docker)
# ===================================
# When running in docker-compose.prod.yml, use service name:
# DATABASE_URL=postgresql://postgres:changeme@postgres:5432/aidashboard

# Logging level (info, debug, warn, error)
RUST_LOG=info

# Ingestion interval in seconds (1 hour = 3600)
INGESTION_INTERVAL_SECS=3600

# External APIs
ARXIV_API_URL=http://export.arxiv.org/api/query

# Trend analysis (OpenRouter). If OPENROUTER_API_KEY is unset, the
# trend-report step is skipped and normal ingestion still runs.
# The report is generated at most ONCE PER DAY (one row per date), regardless
# of how often the ingestion loop runs — so cost is per-day, not per-cycle.
# Default model google/gemma-4-26b-a4b-it:free is free ($0/day). Swap to
# a paid model (e.g. google/gemini-2.5-pro, ~$0.05/day) for higher quality if desired.
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Max items fed to the model per report (drives input token count)
# TREND_MAX_ITEMS=80
# Set to 1 to regenerate today's report even if one already exists (costs extra)
# TREND_FORCE=0

# API keys (to be added as we implement more sources)
# SEMANTIC_SCHOLAR_API_KEY=
# NEWS_API_KEY=
