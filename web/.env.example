# Electric sync service URL
# For local development with Docker:
VITE_ELECTRIC_URL=http://localhost:3000

# For production deployment, copy to .env and set to your server's public IP or domain:
# VITE_ELECTRIC_URL=http://YOUR_VPS_IP:3000
# VITE_ELECTRIC_URL=https://electric.yourdomain.com

# Electric secret (optional for local development)
VITE_ELECTRIC_SECRET=mysecurepassword123456789
