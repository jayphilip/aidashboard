# Production environment variables for docker-compose.prod.yml
# Copy this to .env and update with your actual values

# Database credentials
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=aidashboard

# Electric sync service
# Set to your VPS IP or domain where Electric will be accessible
ELECTRIC_URL=http://localhost:3000
ELECTRIC_SECRET=mysecurepassword123456789

# Rust logging
RUST_LOG=info

# Ingestion settings
INGESTION_INTERVAL_SECS=3600

# API URLs
ARXIV_API_URL=http://export.arxiv.org/api/query
