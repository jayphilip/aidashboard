# Production environment variables for docker-compose.prod.yml
# Copy this to .env and update with your actual values

# Database credentials
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=aidashboard

# Electric sync service
# IMPORTANT: Use your web server URL (port 5173), NOT Electric's port (3000)
# Nginx proxies /v1/shape to Electric internally for security
# Examples:
#   ELECTRIC_URL=http://YOUR_VPS_IP:5173
#   ELECTRIC_URL=https://yourdomain.com
ELECTRIC_URL=http://localhost:5173
ELECTRIC_SECRET=mysecurepassword123456789

# Write API service (for bidirectional sync)
# Use your VPS IP or domain with port 3001
# Examples:
#   API_URL=http://YOUR_VPS_IP:3001
#   API_URL=https://yourdomain.com/api
API_URL=http://localhost:3001

# Rust logging
RUST_LOG=info

# Ingestion settings
INGESTION_INTERVAL_SECS=3600

# API URLs
ARXIV_API_URL=http://export.arxiv.org/api/query
